	author={Erdocia, Joseba and Urtasun, Andoni and Marroyo, Luis},
	booktitle={2020 IEEE 21st Workshop on Control and Modeling for Power Electronics (COMPEL)}, 
	title={Modeling the Inherent Damping of High-Power Inverters}, 
	year={2020},
	volume={},
	number={},
	pages={1-7},
	abstract={In order to decide whether passive or active damping is required in a three-phase inverter, a previous step is to assess the intrinsic damping of the system. However, few works focus on modeling this damping for DC/AC operation. This paper proposes two models to reproduce the damping sources: the simulation model, used to validate the system in large-signal, and the small-signal model, which can be employed for the controller design. Both models have been validated by means of experimental results for a 1.64 MVA inverter.},
	keywords={Damping;Inverters;Switches;Inductors;Resistance;Insulated gate bipolar transistors;Delays;High-power inverter;inherent damping;LC-filter resonance;switching delays},
	doi={10.1109/COMPEL49091.2020.9265677},
