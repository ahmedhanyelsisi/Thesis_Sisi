@INPROCEEDINGS{Lee2009,
	author={Lee, Wook-Jin and Sul, Seung-Ki},
	booktitle={2009 IEEE Energy Conversion Congress and Exposition}, 
	title={DC-link voltage stabilization for reduced dc-link capacitor inverter}, 
	year={2009},
	volume={},
	number={},
	pages={1740-1744},
	abstract={A PMW inverter with reduced dc-link capacitor has a problem that the dc-link voltage is less stable compared to the conventional inverter because of the lack of energy storage capability. The proposed dc-link voltage stabilization algorithm using active damping gives a solution to this problem. To achieve load/source independent stabilization, the source state estimator which estimates both source voltage and current is also proposed. The proposed methods are evaluated by experimental results. While the inverter with a small DC link capacitor tripped due to dc-link overvoltage fault at step load change, the fluctuation of dc-link voltage of the inverter is suppressed under the tolerance range with the proposed method at the same step load change.},
	keywords={Capacitors;Pulse width modulation inverters;Impedance;Voltage control;Voltage fluctuations;Damping;State estimation;Capacitance;Bandwidth;Resistors;Pulse width modulated inverters;dc-link capacitor;DC-link voltage stabilization;Active damping},
	doi={10.1109/ECCE.2009.5316159},
	ISSN={2329-3748},
	month={Sep.},}



@ARTICLE{Ala2016,
  author={Ala, Guido and Giaconia, G. Costantino and Giglia, Graziella and Di Piazza, Maria Carmela and Vitale, Gianpaolo},
  journal={IEEE Transactions on Industry Applications}, 
  title={Design and Performance Evaluation of a High Power-Density EMI Filter for PWM Inverter-Fed Induction-Motor Drives}, 
  year={2016},
  volume={52},
  number={3},
  pages={2397-2404},
  abstract={This paper presents the design of an electromagnetic interference (EMI) filter for a low-voltage high-current induction-motor drives supplied by dc power grids. In order to effectively design the EMI filter, a suitable common-mode/differential-mode (CM/DM) separation technique has been used. Due to the high operating currents, the software-based separation technique using time-domain measurements has been applied. The proposed technique allows the CM and DM sections of the EMI filter to be properly selected in a more economical way, i.e., without the need of a dedicated hardware or costly radio frequency (RF) instrumentation. The design has been done according to a power-density criterion. The effectiveness of the proposed CM/DM separation technique and the EMI filter features/performance has been assessed by experimental tests, carried out with an 1.1-kW pulsewidth modulation (PWM) inverter-fed induction-motor drive, supplied by a 48-V dc power grid.},
  keywords={Electromagnetic interference;Active filters;Induction motor drives;Frequency measurement;Density measurement;Power system measurements;Pulse width modulation;CM and DM separation techniques;Power Converters;Power Density;Common-mode (CM) and differential-mode (DM) separation techniques;electromagnetic interference (EMI) filter;motor drives;power converters;power density},
  doi={10.1109/TIA.2016.2518129},
  ISSN={1939-9367},
  month={May},}

@INPROCEEDINGS{Mueller2023,
  author={Mueller, Jacob A. and Bock, Jonathan and Rodriguez, Luciano Garcia and Palacios, Felipe},
  booktitle={2023 IEEE Energy Conversion Congress and Exposition (ECCE)}, 
  title={Ripple Current and Temperature Distribution in Ceramic Capacitors for DC Link Applications}, 
  year={2023},
  volume={},
  number={},
  pages={5874-5881},
  abstract={The relationship between high-frequency ripple currents and thermal stresses in DC link circuits containing multiple parallel ceramic capacitors is analyzed. The capacitors under consideration are specifically intended for DC link applications and have advantageous properties for high-temperature and high-frequency applications. However, the devices’ effective capacitance varies with both bias voltage and temperature. This creates the possibility of both desirable operating regimes, in which changes in capacitance with temperature balance stresses between the parallel elements, and undesirable operating regimes, in which stresses are magnified for a subset of devices. The analysis presented here focuses on the development of accurate predictive models and experimental observations from a hardware prototype. In the latter, individual ripple current magnitudes and temperatures are measured in a custom 4 kW synchronous boost converter which emulates the conditions of a typical application while enabling extensive device-level instrumentation.},
  keywords={Temperature measurement;Temperature distribution;Predictive models;Ceramic capacitors;Capacitance;Thermal analysis;Impedance;Ceramic capacitors;DC link;ripple current;modeling},
  doi={10.1109/ECCE53617.2023.10362954},
  ISSN={2329-3748},
  month={Oct},}
@INPROCEEDINGS{Mahgoub2016,
	author={El-Daleel, Mohamed Samy and Mahgoub, Osama and Elshafei, Abdel Latif and Mahgoub, Abdelmomen},
	booktitle={2016 Eighteenth International Middle East Power Systems Conference (MEPCON)}, 
	title={Inverter dead-time and non-linearity rejection using a wide bandwidth current controller for PMSM drives with a speed sensor}, 
	year={2016},
	volume={},
	number={},
	pages={687-692},
	abstract={The dead-time and the other inverter nonlinearities known as the inverter non-idealities affect the output voltage and current distortions especially at low output voltages. The inverter non-idealities could be modeled as disturbances acting on the plant's (motor's) input. This paper discusses the effect of current controller design on the rejection of inverter non-idealities induced disturbances acting on the motor's terminals. Compensating for the inverter non-idealities through wide bandwidth current controller without the need of any additional compensation scheme is proposed, studied and verified experimentally at challenging operating conditions. The method is shown to be very suitable for permanent magnet synchronous motors (PMSM) drives with speed sensor as they do not rely on any estimation based on the reference voltage signal unlike sensorless vector induction motors (IM) and sensorless PMSM drives in general. Different design methods for PI current controllers are investigated along with a proposed current controller based on internal model control. The different current controller design techniques are then compared analytically and experimentally to highlight the most suitable one.},
	keywords={Inverters;Bandwidth;Drives;Current control;Mathematical model;Delays;Poles and zeros;Dead-time;PMSM;current controller design;disturbance rejection and internal model control},
	doi={10.1109/MEPCON.2016.7836967},
	ISSN={},
	month={Dec},}

@INPROCEEDINGS{Heldwein2004,
	author={Heldwein, M.L. and Nussbaumer, T. and Kolar, J.W.},
	booktitle={2004 IEEE 35th Annual Power Electronics Specialists Conference (IEEE Cat. No.04CH37551)}, 
	title={Differential mode EMC input filter design for three-phase AC-DC-AC sparse matrix PWM converters}, 
	year={2004},
	volume={1},
	number={},
	pages={284-291 Vol.1},
	abstract={The design of a differential-mode EMC input filter for a three-phase AC-DC-AC very sparse matrix converter intended for electrical machine drive applications is discussed in this paper. A review of the steps to be performed in the course of the filter design is presented and a detailed mathematical model of the EMI test receiver for quasipeak measurement of conducted emissions in the frequency range of 0.15...30 MHz is established. Furthermore, formulas for the estimation of the quasipeak detector output based on the LISN output voltage spectrum are provided. As experimentally verified by using a novel three-phase CM/DM separator this procedure allows an accurate prediction of the converter differential mode conducted emission levels and therefore could be employed in the design process for ensuring compliance to relevant EMC standards.},
	keywords={Electromagnetic compatibility;Filters;Sparse matrices;Pulse width modulation converters;Analog-digital conversion;Matrix converters;Drives;Performance evaluation;Mathematical model;Electromagnetic interference},
	doi={10.1109/PESC.2004.1355757},
	ISSN={0275-9306},
	month={June},}


@ARTICLE{Wen2012,
  author={Wen, Huiqing and Xiao, Weidong and Wen, Xuhui and Armstrong, Peter},
  journal={IEEE Transactions on Vehicular Technology}, 
  title={Analysis and Evaluation of DC-Link Capacitors for High-Power-Density Electric Vehicle Drive Systems}, 
  year={2012},
  volume={61},
  number={7},
  pages={2950-2964},
  abstract={In electric vehicle (EV) inverter systems, direct-current-link capacitors, which are bulky, heavy, and susceptible to degradation from self heating, can become a critical obstacle to high power density. This paper presents a comprehensive method for the analysis and comparative evaluation of dc-link capacitor applications to minimize the volume, mass, and capacitance. Models of equivalent series resistance that are valid over a range of frequency and operating temperature are derived and experimentally validated. The root-mean-square values and frequency spectra of the capacitor current are analyzed with respect to three modulation strategies and various operating conditions over practical ranges of load power factor and modulation index in EV drive systems. The modeling and analysis also consider the self-heating process and resulting core temperature of the dc-link capacitors, which impacts their lifetimes. Based on an 80-kW permanent-magnet (PM) motor drive system, the application of electrolytic capacitors and film capacitors has been evaluated by both simulation and experimental tests. The inverter power density is improved from 2.99 kW/L to 13.3 kW/L, without sacrificing the system performance in terms of power loss, core temperature, and lifetime.},
  keywords={Capacitors;Modulation;Inverters;Reactive power;Support vector machines;Films;Batteries;Direct-current (dc)-link capacitor;electric vehicles (EVs);equivalent series resistance (ESR);parasitic inductance;power density;ripple current stress},
  doi={10.1109/TVT.2012.2206082},
  ISSN={1939-9359},
  month={Sep.},}

