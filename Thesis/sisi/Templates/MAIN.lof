\contentsline {figure}{\numberline {3.3}{\ignorespaces FCS–MPC steady state at 50\% rated speed (1000 rpm) and 50\% rated load (\(1.75~\mathrm {N\,m}\), ideal model). Panels show (a) phase current, (b) \(dq\) currents, and (c) THD (\(8\%\)).}}{27}{figure.caption.16}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces FCS–MPC at low speed (100 rpm, ideal model). Each panel reports phase current, \(i_{dq}\), and THD; the low–load case shows coarse vector quantization and high ripple, while the rated–load case exhibits reduced mismatch and lower THD.}}{28}{figure.caption.17}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces FCS–MPC dynamic response (ideal model) for speed changes within the \(10\%\!\to \!50\%\) rated band (100~rpm to 1000~rpm). Panels report command vs.\ speed, \(i_q\), and phase currents for (a) low load and (b) rated load.}}{28}{figure.caption.18}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces FCS–MPC parameter variation at low speed (100 rpm, ideal model). The prediction model uses \(R_s{+}25\%\) and \(L_{d,q}{-}25\%\). The composite plot shows (left) phase currents with enhanced ripple, (middle) \(d\)- and \(q\)-axis currents, and (right) THD comparison—rising from \(\mathbf {32\%}\) (nominal model) to \(\mathbf {41\%}\) (biased model) due to suboptimal vector selection from prediction errors.}}{29}{figure.caption.19}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces FCS–MPC under load variation at 50\% rated speed (1000 rpm, ideal model). The composite figure shows the speed response (measured), \(q\)-axis currents, and the phase currents during torque steps from 10\% to 100\% of rated in 20\% increments.}}{30}{figure.caption.20}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Control schematic for the Modulated Model Predictive Controller Drive.}}{31}{figure.caption.21}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Modulated MPC (SVM-based) steady state at 50\% rated speed (1000 rpm, ideal model). Each panel shows phase currents, \(i_{dq}\), and THD. The modulated formulation yields very low harmonic content at both loads.}}{33}{figure.caption.22}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Modulated MPC (SVM-based) at 5\% rated speed (100 rpm, ideal model). Each panel shows phase currents, \(i_{dq}\), and THD.}}{34}{figure.caption.23}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Modulated MPC (SVM-based) at 10\% rated speed (200 rpm, ideal model). Each panel shows phase currents, \(i_{dq}\), and THD.}}{34}{figure.caption.24}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Modulated MPC (SVM-based) dynamic response (ideal model) for speed changes within the \(10\%\!\to \!50\%\) rated band (100~rpm to 1000~rpm). Each panel shows command vs.\ speed, \(i_q\), and phase currents. The modulated formulation yields markedly smoother currents and lower torque ripple than FCS and PI.}}{35}{figure.caption.25}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces Modulated MPC under parameter variation at 5\% rated speed (100 rpm, ideal model). The prediction model uses \(R_s{+}25\%\) and \(L_{d,q}{-}25\%\). The figure reports phase currents, \(d\)- and \(q\)-axis currents, and the THD comparison, which remains at \(\mathbf {0.3\%}\)—indistinguishable from the no-variation case—indicating high robustness of bandwidth/cutoff and harmonic performance.}}{35}{figure.caption.26}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Modulated MPC under load variation at 50\% rated speed (1000 rpm, ideal model). The composite figure shows motor speed, \(q\)-axis currents, and phase currents during torque steps from 10\% to 100\% of rated in 20\% increments.}}{36}{figure.caption.27}%
